{
  "name": "plane-service-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "ingest": "tsx scripts/ingest/cli.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "^22.10.0",
    "svelte": "^5.40.0",
    "svelte-check": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "7.3.7",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0"
  },
  "dependencies": {
    "pdfjs-dist": "5.7.284",
    "read-excel-file": "9.3.12",
    "tz-lookup": "6.1.25"
  }
}
