{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"lib": ["ES2023"],
		"types": ["@cloudflare/workers-types"]
	},
	"include": ["src/**/*.ts", "../../src/lib/ingest/**/*.ts", "../../src/lib/csv.ts", "../../src/lib/region.ts"]
}
