{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "plane-service-tracker",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "plane-service-tracker",
			// Replace with the id printed by `wrangler d1 create plane-service-tracker`
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	]
	// Secret: `wrangler secret put ADMIN_TOKEN` (required to replace the candidate list)
}
